{
  "name": "barbershop",
  "version": "1.0.0",
  "private": true,
  "description": "Barbershop — hub-compatible Vite + Express app",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c green,cyan \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:mobile": "npm start --prefix mobile",
    "dev:web": "npm run web --prefix mobile",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
