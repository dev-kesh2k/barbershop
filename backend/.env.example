# Local (sem Postgres): SQLite em arquivo
DATABASE_URL="file:./dev.db"

# Hub / produção (Postgres) — o portal sobrescreve automaticamente:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/barbershop?schema=public"

JWT_SECRET="change-me-in-production-min-32-chars!!"
PORT=4002
API_PORT=4002
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081"

# Informativo no Hub (slug padrão barbershop). Apache faz o proxy /barbershop/api → /
PUBLIC_PATH=/barbershop

# No Hub: CIDR do proxy (ex. 172.16.0.0/12). Local: true ou 1
TRUST_PROXY=
